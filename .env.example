# Admin login (required)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string

# Bind address. Keep 127.0.0.1 unless you put a reverse proxy in front.
BIND_HOST=127.0.0.1
BIND_PORT=8080

# Path to the Zomboid user data directory (contains Server/, Logs/, Saves/)
ZOMBOID_HOME=/home/steam/Zomboid

# Prefix for Server/<name>.ini and Server/<name>_SandboxVars.lua
PZ_SERVER_NAME=servertest

# Optional: game install dir (used to locate steamapps/workshop if STEAM_WORKSHOP_DIR is empty)
PZ_INSTALL_DIR=/home/steam/pzserver

# Workshop content cache (Steam app 108600)
STEAM_WORKSHOP_DIR=/home/steam/pzserver/steamapps/workshop/content/108600

# Process control — use whatever this container already uses to run PZ
PZ_START_CMD=systemctl start zomboid
PZ_STOP_CMD=systemctl stop zomboid
PZ_STATUS_CMD=systemctl is-active zomboid

# Optional RCON (password is read from the server .ini if unset)
RCON_HOST=127.0.0.1
RCON_PORT=

# Directory for timestamped config backups
BACKUP_DIR=./backups
